# ตัวอย่างไฟล์ตั้งค่า
# - Docker Compose: คัดลอกเป็น .env ที่ root ของ repository
# - รันแบบไม่ใช้ Container: export ค่าเหล่านี้ หรือใช้ node --env-file=.env
# ห้าม commit ไฟล์ .env หรือ secret ที่มีค่าจริงลงใน Repository

# --- Compose / Images ---
COMPOSE_PROJECT_NAME=starter-app-devops
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080
IMAGE_TAG=local
BACKEND_IMAGE=starter-app-devops-backend
FRONTEND_IMAGE=starter-app-devops-frontend
BACKUP_IMAGE=starter-app-devops-backup
TZ=Asia/Bangkok

# --- Back-end ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*
APP_VERSION=1.0.0
PGPOOL_MAX=10

# --- ฐานข้อมูล PostgreSQL ---
# กำหนด DATABASE_URL อย่างเดียวก็ได้ หรือจะกำหนด PG* ทีละตัวก็ได้
# DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/psu_activities
# เมื่อใช้ Compose ค่า PGHOST จะถูกกำหนดเป็น db โดยอัตโนมัติ
PGHOST=localhost
PGPORT=5432
PGDATABASE=psu_activities
PGUSER=app_user
# ใช้ PGPASSWORD เฉพาะการรันแบบไม่ใช้ Container
# PGPASSWORD=CHANGE_ME

# Compose อ่านรหัสผ่านจาก Docker secrets-compatible files
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
BACKUP_ENCRYPTION_PASSPHRASE_FILE=./secrets/backup_encryption_passphrase.txt

# --- Backup ---
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# --- Monitoring (bind เฉพาะ localhost โดยค่าเริ่มต้น) ---
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
